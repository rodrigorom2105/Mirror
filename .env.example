OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3:4b-instruct
EMBED_MODEL=qwen3-embedding:0.6b
CHROMA_PATH=./data/chroma_db

# Silencia la telemetría de ChromaDB en los logs
ANONYMIZED_TELEMETRY=False

# Logs verbosos en consola (transcripción, pipeline, API)
DEV_MODE=true

# --- Audio pipeline (STT) ---
STT_ENGINE=whisperkit
WHISPERKIT_CLI=whisperkit-cli
WHISPERKIT_MODEL=base
# Opcional pero recomendado: ruta a la carpeta del modelo CoreML ya descargado
# (contiene AudioEncoder.mlmodelc, TextDecoder.mlmodelc, MelSpectrogram.mlmodelc).
# argmax-cli 1.0 tiene rota la resolución por nombre (--model); --model-path la
# evita. Si se define, tiene prioridad sobre WHISPERKIT_MODEL y --stt-model.
# WHISPERKIT_MODEL_PATH=/ruta/a/.../whisperkit-coreml/openai_whisper-small
FASTER_WHISPER_MODEL=small
STT_TIMEOUT=120
AUDIO_MIN_DURATION=0.5
AUDIO_MAX_DURATION=120
AUDIO_MAX_SIZE_MB=25

# --- Memoria, perfil y sesión ---
PROFILE_DB_PATH=./data/profile.db
PROFILE_TREND_WINDOW=7          # entradas para la tendencia reciente
PROFILE_SYNTHESIS_EVERY=5       # regenera la síntesis narrativa cada N entradas
SESSION_IDLE_MINUTES=30         # reusar la sesión de chat si la última fue hace <N min

# --- Recuperación de contexto (RAG con scoring) ---
RETRIEVE_W_SIM=0.6              # peso de la similitud semántica
RETRIEVE_W_RECENCY=0.3          # peso de la recencia
RETRIEVE_W_INTENSITY=0.1        # peso de la intensidad emocional
RETRIEVE_HALF_LIFE_DAYS=14      # vida media del decaimiento por recencia
RELEVANCE_MIN_SOURCE_SCORE=0.35 # umbral para filtrar contexto poco relevante

# --- Motor de señales ---
SIGNAL_INTENSITY_THRESHOLD=5    # intensidad > N en cuadrante negativo dispara acompañamiento
SIGNAL_STREAK_MIN=3             # días para considerar una racha
SIGNAL_RECURRENCE_MIN=3         # repeticiones para un disparador recurrente

# --- Pipeline de acompañamiento ---
COMPANION_COOLDOWN_HOURS=6      # no intervenir de nuevo antes de N horas
COMPANION_MIN_ENTRIES=3         # entradas mínimas para razonar
COMPANION_RELEVANCE_FLOOR=0.5   # score mínimo de señal para intervenir
